# =============================================================================
# Variables de entorno de la stack (docker-compose.yml las lee automaticamente)
# =============================================================================
# Copiar este archivo a .env y ajustar los valores:
#   cp .env.example .env
#
# El archivo .env esta en .gitignore: nunca se sube al repo.
# =============================================================================

# ---------- Entorno ----------
NODE_ENV=production

# ---------- Puertos publicados al host ----------
# Puerto del frontend (http://localhost:FRONTEND_PORT)
FRONTEND_PORT=80
# Puerto del backend (API REST)
BACKEND_PORT=4000
# Puerto del broker MQTT (ESP32)
MQTT_PORT=1883
# Puerto de PostgreSQL expuesto SOLO al host local (127.0.0.1).
# Se usa 15432 para NO chocar con un Postgres nativo que pueda haber en el host.
# Dentro del contenedor, Postgres siempre escucha en 5432 (no cambia).
# Para NO exponerlo en absoluto, comenta las lineas 'ports' del servicio postgres.
POSTGRES_HOST_PORT=15432

# ---------- PostgreSQL ----------
POSTGRES_DB=sistema_enfermeras
POSTGRES_USER=postgres
# CAMBIAR en produccion. Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=admin

# ---------- JWT ----------
# Generar con: openssl rand -hex 32
# IMPORTANTE: si el secreto contiene el caracter $, DUPLICALO como $$ en este archivo
# (sino docker compose intentara interpretarlo como variable).
# Recomendado: usa openssl rand -hex 32 (solo hex, sin caracteres especiales).
# Aplicar en la terminal: openssl rand -hex 32
JWT_SECRET=cambiar_por_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# ---------- MQTT / Mosquitto ----------
# El broker genera sus credenciales EN CADA ARRANQUE a partir de estos valores.
# OJO: los ESP32 ya instalados usan la contrasena con la que fueron programados.
# Si la cambias aqui, debes actualizarla tambien en los dispositivos o dejaran
# de conectarse ("Connection Refused: not authorised").
MQTT_USER=esp32
MQTT_PASSWORD=CAMBIA_ESTA_PASSWORD

# ---------- Integracion EsSalud ----------
API_ESSI=http://IP_DEL_SERVICIO_HOSPITALARIO/ruta/del/endpoint
SYNC_INTERVAL_MINUTES=5

# ---------- Rate limiting del backend ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ---------- Red Docker ----------
# Subred de la red interna del stack. Solo hay que tocarla si el servidor ya
# tiene muchos stacks y Docker responde:
#   "all predefined address pools have been fully subnetted"
# Elige un /24 libre. Comprueba cual lo esta con:
#   docker network inspect $(docker network ls -q) --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' | sort
DOCKER_SUBNET=10.251.0.0/24
