# =============================================================================
# .env del backend — SOLO PARA DESARROLLO LOCAL (sin Docker)
# =============================================================================
# Cuando se despliega con Docker Compose, las variables de entorno vienen del
# archivo .env de la raiz del repo (../env), inyectadas por docker-compose.yml.
# Este archivo NO se usa dentro del contenedor.
#
# Para correr el backend localmente con `npm run dev`:
#   cp .env.example .env
#   (luego ajustar valores)
# =============================================================================

NODE_ENV=development
PORT=4000

# JWT - generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_secreto_seguro
JWT_EXPIRES_IN=24h

# PostgreSQL (apuntar al Postgres que tengas corriendo localmente)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=sistema_enfermeras
PGPASSWORD=admin
PGPORT=5432

# API externa EsSalud
API_ESSI=http://IP_DEL_SERVICIO_HOSPITALARIO/ruta/del/endpoint
SYNC_INTERVAL_MINUTES=5

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=esp32
MQTT_PASSWORD=CAMBIA_ESTA_PASSWORD

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Logging: error | warn | info | http | debug
LOG_LEVEL=info
